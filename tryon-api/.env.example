# Copy to .env for local testing; on Vercel set these in Project → Settings → Environment Variables.
# Never commit the real values.

# Your Decart API key (platform.decart.ai). Server-only: it is never sent to the browser.
DECART_API_KEY=

# Sites allowed to ask for tokens, comma-separated, exact origins (scheme + host, no path).
# GitHub Pages serves from the user domain, so the origin has no /fit-your-fashion part.
ALLOWED_ORIGINS=https://farsanafarsu.github.io,http://localhost:3000

# Abuse limits
RATE_LIMIT_PER_IP=5
RATE_LIMIT_WINDOW_SECONDS=600
DAILY_TOKEN_CAP=100
MAX_SESSION_SECONDS=180

# Optional but recommended in production: Upstash Redis (free tier) so limits hold across serverless
# instances. Without these, counters live in memory and reset whenever an instance restarts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
