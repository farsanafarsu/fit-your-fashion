# Website (Next.js) settings. Public by design: only the token service URL, never the Decart key.
# Local: copy to .env.local. GitHub Pages build: add a repository variable TRYON_TOKEN_URL
# (Settings → Secrets and variables → Actions → Variables); the deploy workflow passes it through.
NEXT_PUBLIC_TRYON_TOKEN_URL=http://localhost:3001/api/tryon-token
